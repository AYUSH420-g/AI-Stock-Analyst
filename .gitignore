# ==============================================================================
# AI Stock Market Simulator & Research Platform - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files & Python Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Virtual Environments (Python)
# ------------------------------------------------------------------------------
venv/
venv*/
ENV/
env/
env*/
.venv/
backend/venv/
backend/env/

# ------------------------------------------------------------------------------
# Testing & Code Quality Artifacts (Pytest, Coverage, MyPy)
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
.turbo/
.next/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Local Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
*.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
# Keep example environment files tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# Databases & Persistent Local Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
stock_market.db
backend/stock_market.db
postgres_data/

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Visual Studio Code (ignore user settings and workspace state, keep recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
